{
  "name": "@polyhymnia/audio-analysis-pitchy",
  "version": "0.3.0",
  "type": "module",
  "description": "Pitchy adapter and browser pitch-analysis worker.",
  "license": "MIT",
  "sideEffects": [
    "./dist/pitch-worker.js"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "default": "./dist/browser/index.js"
    },
    "./pitch-worker.js": "./dist/pitch-worker.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.browser.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.browser.json --noEmit && tsc -p tsconfig.asset.json"
  },
  "dependencies": {
    "@polyhymnia/audio-analysis": "workspace:^",
    "pitchy": "4.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adrian729/audio-analysis.git",
    "directory": "packages/audio-analysis-pitchy"
  },
  "homepage": "https://github.com/adrian729/audio-analysis/tree/main/packages/audio-analysis-pitchy#readme",
  "bugs": {
    "url": "https://github.com/adrian729/audio-analysis/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@polyhymnia/audio-transport": "workspace:*"
  }
}
